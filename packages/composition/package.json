{
  "name": "@vidpilot/composition",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "render-document": [
        "dist/render-document.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./render-document": {
      "types": "./dist/render-document.d.ts",
      "default": "./dist/render-document.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "@remotion/captions": "4.0.482",
    "@remotion/media": "4.0.482",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.482"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
