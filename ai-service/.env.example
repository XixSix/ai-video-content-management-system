AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=50051
AI_SERVICE_MAX_WORKERS=4

# ASR provider: noop or faster-whisper
ASR_PROVIDER=noop
ASR_LANGUAGE=vi
ASR_MODEL_SIZE=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_CPU_THREADS=4
ASR_NUM_WORKERS=1
ASR_MODEL_STORAGE_PATH=
ASR_LOCAL_FILES_ONLY=false

CHAPTERING_MODEL_NAME=rule-based-chaptering-v1
CHAPTERING_MAX_UNIT_DURATION_SECONDS=30
CHAPTERING_PAUSE_BOUNDARY_SECONDS=1
CHAPTERING_CONTEXT_WINDOW_SECONDS=90
CHAPTERING_CANDIDATE_SCORE_CONTEXT_SECONDS=90
CHAPTERING_CANDIDATE_LONG_PAUSE_SECONDS=1
CHAPTERING_CANDIDATE_MAX_PAUSE_SCORE_SECONDS=5
CHAPTERING_CANDIDATE_MIN_CONTEXT_TEXT_CHARS=120
CHAPTERING_CANDIDATE_DISCOURSE_MARKER_WEIGHT=0.30
CHAPTERING_CANDIDATE_PAUSE_WEIGHT=0.25
CHAPTERING_CANDIDATE_LEXICAL_SHIFT_WEIGHT=0.20
CHAPTERING_CANDIDATE_BOUNDARY_QUALITY_WEIGHT=0.15
CHAPTERING_CANDIDATE_DURATION_SANITY_WEIGHT=0.10
CHAPTERING_EMBEDDING_CANDIDATE_MIN_LIMIT=12
CHAPTERING_EMBEDDING_CANDIDATE_MAX_LIMIT=40
CHAPTERING_EMBEDDING_CANDIDATE_MULTIPLIER=4
CHAPTERING_CANDIDATE_TOP_SCORE_FRACTION=0.60
