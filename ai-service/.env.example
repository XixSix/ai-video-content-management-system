AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=50051
AI_SERVICE_MAX_WORKERS=4

# ASR provider: noop or faster-whisper
ASR_PROVIDER=noop
ASR_LANGUAGE=vi
ASR_MODEL_SIZE=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_CPU_THREADS=4
ASR_NUM_WORKERS=1
ASR_MODEL_STORAGE_PATH=
ASR_LOCAL_FILES_ONLY=false

# Diarization provider: noop or pyannote
DIARIZATION_PROVIDER=noop
PYANNOTE_AUTH_TOKEN=
PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cpu

# Source separation provider: noop or demucs
# Demucs model defaults to htdemucs. Alternatives:
# - htdemucs_ft: better/slower
# - mdx_extra_q: lighter CPU option
SOURCE_SEPARATION_PROVIDER=noop
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cpu
DEMUCS_OUTPUT_DIR=/tmp/vid-pilot-demucs
DEMUCS_JOBS=1
DEMUCS_SHIFTS=0
DEMUCS_OVERLAP=0.25

# Audio decoder provider: noop or torchaudio
AUDIO_DECODER_PROVIDER=torchaudio
AUDIO_MIN_SAMPLE_RATE=8000
AUDIO_MAX_SAMPLE_RATE=192000
AUDIO_SUPPORTED_CHANNELS=[1,2]
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_TARGET_LOUDNESS=-16
AUDIO_MIN_LOUDNESS=-70
AUDIO_MIN_NORMALIZE_SECONDS=0.4
AUDIO_PEAK_CEILING=0.98
AUDIO_WAV_PCM_SAMPLE_WIDTH_BYTES=2
AUDIO_ENABLE_LOUDNESS_NORMALIZATION=true

# VAD provider: noop or silero
VAD_PROVIDER=silero
VAD_SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=100
VAD_SPEECH_PAD_MS=30
VAD_USE_ONNX=false
VAD_MIN_TOTAL_SPEECH_MS=250
VAD_MIN_SPEECH_RATIO=0

OFFLINE_ASR_PAD_SECONDS=0.25
OFFLINE_ASR_MERGE_GAP_SECONDS=0.6
OFFLINE_ASR_MAX_WINDOW_SECONDS=30
OFFLINE_ASR_MIN_WINDOW_SECONDS=1.2

CHAPTERING_STRATEGY=segment
CHAPTERING_MODEL_NAME=segment-chaptering-v1
CHAPTERING_BOUNDARY_EVALUATION_PROVIDER=noop
CHAPTERING_TITLE_PROVIDER=noop
SHORT_CLIP_CANDIDATE_PROVIDER=noop
SHORT_CLIP_MODEL_NAME=noop-short-clip-v1
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL_NAME=Qwen/Qwen3-8B
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
CHAPTERING_EMBEDDING_PROVIDER=noop
CHAPTERING_EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
CHAPTERING_EMBEDDING_DEVICE=cpu
CHAPTERING_EMBEDDING_BATCH_SIZE=8
CHAPTERING_EMBEDDING_MAX_SEQUENCE_LENGTH=2048
CHAPTERING_EMBEDDING_CACHE_PATH=
CHAPTERING_EMBEDDING_LOCAL_FILES_ONLY=false
CHAPTERING_TARGET_UNIT_DURATION_SECONDS=20
CHAPTERING_MAX_UNIT_DURATION_SECONDS=30
CHAPTERING_TARGET_UNIT_WORDS=80
CHAPTERING_MAX_UNIT_WORDS=160
CHAPTERING_MAX_UNIT_CHARS=1200
CHAPTERING_PAUSE_BOUNDARY_SECONDS=1
CHAPTERING_PUNCTUATION_POOR_THRESHOLD=0.15
CHAPTERING_UNIT_REPAIR_SHORT_DURATION_SECONDS=4
CHAPTERING_UNIT_REPAIR_MIN_WORDS=8
CHAPTERING_UNIT_REPAIR_FRAGMENT_MAX_WORDS=2
CHAPTERING_UNIT_REPAIR_SPARSE_DURATION_SECONDS=6
CHAPTERING_UNIT_REPAIR_CONTINUATION_GAP_SECONDS=0.05
CHAPTERING_CONTEXT_WINDOW_SECONDS=90
CHAPTERING_CANDIDATE_SCORE_CONTEXT_SECONDS=90
CHAPTERING_CANDIDATE_LONG_PAUSE_SECONDS=1
CHAPTERING_CANDIDATE_MAX_PAUSE_SCORE_SECONDS=5
CHAPTERING_CANDIDATE_MIN_CONTEXT_TEXT_CHARS=120
CHAPTERING_CANDIDATE_DISCOURSE_MARKER_WEIGHT=0.30
CHAPTERING_CANDIDATE_PAUSE_WEIGHT=0.25
CHAPTERING_CANDIDATE_LEXICAL_SHIFT_WEIGHT=0.20
CHAPTERING_CANDIDATE_BOUNDARY_QUALITY_WEIGHT=0.15
CHAPTERING_CANDIDATE_DURATION_SANITY_WEIGHT=0.10
CHAPTERING_EMBEDDING_CANDIDATE_MIN_LIMIT=12
CHAPTERING_EMBEDDING_CANDIDATE_MAX_LIMIT=40
CHAPTERING_EMBEDDING_CANDIDATE_MULTIPLIER=4
CHAPTERING_CANDIDATE_TOP_SCORE_FRACTION=0.60
CHAPTERING_VALLEY_SMOOTHING_RADIUS=1
CHAPTERING_VALLEY_PEAK_WINDOW=2
CHAPTERING_VALLEY_MIN_DEPTH=0.18
CHAPTERING_VALLEY_SEMANTIC_WEIGHT=0.70
