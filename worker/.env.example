RABBITMQ_URL=amqp://guest:guest@localhost:5672
TRANSCRIPT_QUEUE_NAME=transcript_queue
TRANSCRIPT_TASK_NAME=transcript_task
CHAPTERING_QUEUE_NAME=chaptering_queue
CHAPTERING_TASK_NAME=chaptering_task
WORKER_CONCURRENCY=1
WORKER_PREFETCH_MULTIPLIER=1
WORKER_MAX_TASKS_PER_CHILD=20
TASK_MAX_RETRIES=3
TASK_DEFAULT_RETRY_DELAY_SECONDS=30
TASK_SOFT_TIME_LIMIT_SECONDS=3600
TASK_TIME_LIMIT_SECONDS=3900
BROKER_HEARTBEAT_SECONDS=30
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avcms
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
TMP_DIR=/tmp/avcms-worker
STORAGE_DIR=app/storage
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_TIMEOUT_SECONDS=1800
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AI_SERVICE_GRPC_TARGET=localhost:50051
AI_SERVICE_GRPC_TIMEOUT_SECONDS=1800
CHAPTERING_PIPELINE_STRATEGY=candidate
CHAPTERING_MAX_UNIT_DURATION_SECONDS=30
CHAPTERING_PAUSE_BOUNDARY_SECONDS=1.2
CHAPTERING_CONTEXT_WINDOW_SECONDS=90
CHAPTERING_CANDIDATE_SCORE_CONTEXT_SECONDS=60
CHAPTERING_CANDIDATE_LONG_PAUSE_SECONDS=1.2
CHAPTERING_CANDIDATE_MAX_PAUSE_SCORE_SECONDS=3
CHAPTERING_CANDIDATE_MIN_CONTEXT_TEXT_CHARS=120
CHAPTERING_EMBEDDING_CANDIDATE_MIN_LIMIT=80
CHAPTERING_EMBEDDING_CANDIDATE_MAX_LIMIT=150
CHAPTERING_EMBEDDING_CANDIDATE_MULTIPLIER=10
CHAPTERING_CANDIDATE_TOP_SCORE_FRACTION=0.7
CHAPTERING_CANDIDATE_DISCOURSE_MARKER_WEIGHT=0.3
CHAPTERING_CANDIDATE_PAUSE_WEIGHT=0.25
CHAPTERING_CANDIDATE_LEXICAL_SHIFT_WEIGHT=0.2
CHAPTERING_CANDIDATE_BOUNDARY_QUALITY_WEIGHT=0.15
CHAPTERING_CANDIDATE_DURATION_SANITY_WEIGHT=0.1
LOG_LEVEL=INFO
