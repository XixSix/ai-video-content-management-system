RABBITMQ_URL=amqp://guest:guest@localhost:5672
TRANSCRIPT_QUEUE_NAME=transcript_queue
TRANSCRIPT_TASK_NAME=transcript_task
WORKER_CONCURRENCY=1
WORKER_PREFETCH_MULTIPLIER=1
WORKER_MAX_TASKS_PER_CHILD=20
TASK_MAX_RETRIES=3
TASK_DEFAULT_RETRY_DELAY_SECONDS=30
TASK_SOFT_TIME_LIMIT_SECONDS=3600
TASK_TIME_LIMIT_SECONDS=3900
BROKER_HEARTBEAT_SECONDS=30
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avcms
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
TMP_DIR=/tmp/avcms-worker
STORAGE_DIR=app/storage
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_TIMEOUT_SECONDS=1800
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AI_SERVICE_GRPC_TARGET=localhost:50051
AI_SERVICE_GRPC_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
