NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://vidpilot:vidpilot@localhost:5432/vidpilot-db?schema=public
RABBITMQ_URL=amqp://vidpilotadmin:vidpilotadmin@localhost:5672
REDIS_URL=redis://localhost:6379

JWT_SECRET=development-jwt-secret-change-me-32-chars
REFRESH_TOKEN_SECRET=development-refresh-secret-change-me-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=2592000
SALT_ROUNDS=12
REFRESH_COOKIE_NAME=refreshToken

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REFRESH_RATE_LIMIT=30
TRANSCRIPT_GENERATE_RATE_LIMIT_WINDOW_MS=3600000
TRANSCRIPT_GENERATE_RATE_LIMIT=10
CORS_ORIGINS=http://localhost:5173

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vidpilot-media
S3_ACCESS_KEY_ID=vidpilotadmin
S3_SECRET_ACCESS_KEY=vidpilotadmin
S3_FORCE_PATH_STYLE=true
MAX_MULTIPART_PARTS=10000
MULTIPART_THRESHOLD_BYTES=104857600
MULTIPART_PART_SIZE_BYTES=10485760
PRESIGNED_UPLOAD_EXPIRES_SECONDS=900
PRESIGNED_DOWNLOAD_EXPIRES_SECONDS=900

YOUTUBE_CLIENT_ID=local-youtube-client-id
YOUTUBE_CLIENT_SECRET=local-youtube-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/platform-accounts/YOUTUBE/callback
FACEBOOK_APP_ID=local-facebook-app-id
FACEBOOK_APP_SECRET=local-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/v1/platform-accounts/FACEBOOK/callback
FACEBOOK_GRAPH_API_VERSION=v25.0
PLATFORM_TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PLATFORM_OAUTH_STATE_TTL_MS=600000
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:5173/social-accounts/callback
