// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MediaType {
  VIDEO
  AUDIO
  IMAGE
  SUBTITLE
  DOCUMENT
}

enum MediaStatus {
  UPLOADING
  UPLOADED
  FAILED
  DELETED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DELETED
}

enum WorkspaceMemberRole {
  OWNER
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum NotificationType {
  WORKSPACE_INVITATION
}

enum ProjectMediaRole {
  SOURCE
  OVERLAY
  AUDIO_BED
  GENERATED
  REFERENCE
}

enum JobType {
  TRANSCRIBE
  GENERATE_SUBTITLE
  GENERATE_CHAPTERS
  GENERATE_SHORT_CLIPS
  GENERATE_AI_SUGGESTIONS
  GENERATE_SUGGESTIONS
  EXPORT_RENDER
  BURN_SUBTITLE
  PUBLISH
  GENERATE_THUMBNAIL
  GENERATE_THUMBNAIL_SPRITE
  GENERATE_WAVEFORM_PEAK
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  TRANSCRIBING
  GENERATING_SUBTITLE
  BURNING_SUBTITLE
  GENERATING_CHAPTERS
  GENERATING_SHORT_CLIPS
  GENERATING_SUGGESTIONS
  GENERATING_MEDIA_PREVIEW
  PUBLISHING
  COMPLETED
  FAILED
  CANCELED
}

enum TranscriptSource {
  IMPORTED
  LOCAL
}

enum AsrModel {
  FASTER_WHISPER @map("FASTER-WHISPER")
  WHISPER
}

enum ModelSize {
  LARGE_V3       @map("large-v3")
  LARGE_V3_TURBO @map("large-v3-turbo")
  MEDIUM         @map("medium")
  MEDIUM_EN      @map("medium.en")
  SMALL          @map("small")
  SMALL_EN       @map("small.en")
  BASE           @map("base")
  BASE_EN        @map("base.en")
  TINY           @map("tiny")
  TINY_EN        @map("tiny.en")
}

enum ChapterSource {
  IMPORTED
  WORDS
  SEGMENTS
}

enum ClipCandidateStatus {
  CANDIDATE
  SELECTED
  REJECTED
}

enum ShortClipStatus {
  PENDING
  RENDERING
  READY
  FAILED
  DELETED
}

enum AssetType {
  THUMBNAIL
  THUMBNAIL_SPRITE
  SUBTITLE_SRT
  SUBTITLE_VTT
  BURNED_SUBTITLE_VIDEO
  EXPORT_VIDEO
  EXPORT_AUDIO
  WAVEFORM_PEAKS
}

enum TargetType {
  MEDIA
  PROJECT
  TRANSCRIPT
  VIDEO_CHAPTER
  SHORT_CLIP
  PUBLISH_TASK
}

enum SuggestionType {
  TITLE
  CAPTION
  HASHTAG
  DESCRIPTION
  PLATFORM_CONTENT
}

enum Platform {
  YOUTUBE
  TIKTOK
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  X
}

enum PlatformAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  email                String     @unique @db.VarChar(255)
  passwordHash         String     @map("password_hash") @db.Text
  fullName             String?    @map("full_name") @db.VarChar(255)
  avatarUrl            String?    @map("avatar_url") @db.Text
  preferredWorkspaceId String?    @map("preferred_workspace_id") @db.Uuid
  role                 UserRole   @default(USER)
  status               UserStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  media                        Media[]
  ownedWorkspaces              Workspace[]           @relation("WorkspaceOwner")
  preferredWorkspace           Workspace?            @relation("PreferredWorkspace", fields: [preferredWorkspaceId], references: [id], onDelete: SetNull)
  workspaceMemberships         WorkspaceMember[]
  projects                     Project[]
  processingJobs               ProcessingJob[]
  shortClips                   ShortClip[]
  generatedAssets              GeneratedAsset[]
  aiSuggestions                AiSuggestion[]
  connectedPlatformAccounts    PlatformAccount[]     @relation("PlatformAccountConnectedBy")
  initiatedPlatformOAuthStates PlatformOAuthState[]  @relation("PlatformOAuthStateInitiatedBy")
  publishTasks                 PublishTask[]
  authSessions                 AuthSession[]
  auditLogs                    AuditLog[]
  transcriptEditDrafts         TranscriptEditDraft[]
  savedEditorSnapshots         EditorSnapshot[]      @relation("EditorSnapshotSavedBy")
  sentWorkspaceInvitations     WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  receivedWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationInvitee")
  receivedNotifications        Notification[]        @relation("NotificationRecipient")
  actedNotifications           Notification[]        @relation("NotificationActor")

  @@index([preferredWorkspaceId])
  @@map("users")
}

model AuthSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  jti       String  @unique @db.Uuid
  userAgent String? @map("user_agent") @db.Text
  ipAddress String? @map("ip_address") @db.VarChar(100)

  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model Workspace {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid

  name String @db.VarChar(255)
  slug String @unique @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  preferredByUsers    User[]                @relation("PreferredWorkspace")
  members             WorkspaceMember[]
  invitations         WorkspaceInvitation[]
  media               Media[]
  projects            Project[]
  platformAccounts    PlatformAccount[]
  platformOAuthStates PlatformOAuthState[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid

  role WorkspaceMemberRole @default(OWNER)

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  inviterId   String @map("inviter_id") @db.Uuid
  inviteeId   String @map("invitee_id") @db.Uuid

  status      WorkspaceInvitationStatus @default(PENDING)
  expiresAt   DateTime                  @map("expires_at")
  respondedAt DateTime?                 @map("responded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("WorkspaceInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   User      @relation("WorkspaceInvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  notification Notification?

  @@index([workspaceId])
  @@index([inviteeId, status, createdAt])
  @@index([status, expiresAt])
  @@map("workspace_invitations")
}

model Notification {
  id                    String  @id @default(uuid()) @db.Uuid
  recipientId           String  @map("recipient_id") @db.Uuid
  actorId               String? @map("actor_id") @db.Uuid
  workspaceInvitationId String? @unique @map("workspace_invitation_id") @db.Uuid

  type    NotificationType
  title   String           @db.VarChar(255)
  message String           @db.Text
  data    Json?

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  recipient           User                 @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor               User?                @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspaceInvitation WorkspaceInvitation? @relation(fields: [workspaceInvitationId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

model Media {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  type        MediaType

  title            String? @db.VarChar(255)
  description      String? @db.Text
  originalFilename String  @map("original_filename") @db.VarChar(255)

  s3Bucket String  @map("s3_bucket") @db.VarChar(255)
  s3Key    String  @map("s3_key") @db.Text
  s3Region String? @map("s3_region") @db.VarChar(100)
  s3Etag   String? @map("s3_etag") @db.VarChar(255)
  uploadId String? @map("upload_id") @db.Text

  duration      Float?
  fileSizeBytes BigInt? @map("file_size_bytes")
  mimeType      String? @map("mime_type") @db.VarChar(100)
  width         Int?
  height        Int?
  metadata      Json?

  status MediaStatus @default(UPLOADED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  processingJobs     ProcessingJob[]
  transcripts        Transcript[]
  transcriptSegments TranscriptSegment[]
  transcriptWords    TranscriptWord[]
  videoChapters      VideoChapter[]
  clipCandidates     ClipCandidate[]
  shortClips         ShortClip[]
  sourceProjects     Project[]           @relation("ProjectSourceMedia")
  thumbnailProjects  Project[]           @relation("ProjectThumbnailMedia")
  projectMedia       ProjectMedia[]
  generatedAssets    GeneratedAsset[]
  publishTasks       PublishTask[]

  @@unique([s3Bucket, s3Key])
  @@index([userId])
  @@index([workspaceId])
  @@index([status])
  @@index([type])
  @@map("media")
}

model Project {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  sourceMediaId    String? @map("source_media_id") @db.Uuid
  thumbnailMediaId String? @map("thumbnail_media_id") @db.Uuid

  title       String        @db.VarChar(255)
  slug        String        @db.VarChar(255)
  status      ProjectStatus @default(DRAFT)
  aspectRatio String        @default("9:16") @map("aspect_ratio") @db.VarChar(20)
  duration    Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceMedia    Media?    @relation("ProjectSourceMedia", fields: [sourceMediaId], references: [id], onDelete: SetNull)
  thumbnailMedia Media?    @relation("ProjectThumbnailMedia", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)

  projectMedia    ProjectMedia[]
  editorSnapshot  EditorSnapshot?
  processingJobs  ProcessingJob[]
  transcripts     Transcript[]
  videoChapters   VideoChapter[]
  clipCandidates  ClipCandidate[]
  shortClips      ShortClip[]
  generatedAssets GeneratedAsset[]
  aiSuggestions   AiSuggestion[]
  publishTasks    PublishTask[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([sourceMediaId])
  @@index([thumbnailMediaId])
  @@index([status])
  @@map("projects")
}

model ProjectMedia {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid

  role ProjectMediaRole

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([projectId, mediaId, role])
  @@index([projectId])
  @@index([mediaId])
  @@index([role])
  @@map("project_media")
}

model EditorSnapshot {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @unique @map("project_id") @db.Uuid

  version  Int  @default(1)
  snapshot Json @map("snapshot_json")

  savedByUserId String?  @map("saved_by_user_id") @db.Uuid
  savedAt       DateTime @default(now()) @map("saved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  savedBy User?   @relation("EditorSnapshotSavedBy", fields: [savedByUserId], references: [id], onDelete: SetNull)

  @@index([savedByUserId])
  @@map("editor_snapshots")
}

model ProcessingJob {
  id        String  @id @default(uuid()) @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid

  jobType JobType   @map("job_type")
  status  JobStatus @default(PENDING)

  progress     Int?    @default(0)
  currentStep  String? @map("current_step") @db.VarChar(255)
  errorMessage String? @map("error_message") @db.Text

  queueName      String? @map("queue_name") @db.VarChar(100)
  taskName       String? @map("task_name") @db.VarChar(100)
  externalTaskId String? @map("external_task_id") @db.VarChar(255)
  attemptCount   Int     @default(0) @map("attempt_count")

  input  Json?
  output Json?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  media   Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  transcripts     Transcript[]
  videoChapters   VideoChapter[]
  clipCandidates  ClipCandidate[]
  generatedAssets GeneratedAsset[]
  publishTasks    PublishTask[]
  events          JobEvent[]

  @@index([userId])
  @@index([mediaId])
  @@index([projectId])
  @@index([jobType])
  @@index([status])
  @@map("processing_jobs")
}

model JobEvent {
  id    String @id @default(uuid()) @db.Uuid
  jobId String @map("job_id") @db.Uuid

  eventType String  @map("event_type") @db.VarChar(100)
  message   String? @db.Text
  progress  Int?
  payload   Json?

  createdAt DateTime @default(now()) @map("created_at")

  job ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
  @@map("job_events")
}

model Transcript {
  id        String  @id @default(uuid()) @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  jobId     String? @map("job_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid

  language  String?          @db.VarChar(20)
  source    TranscriptSource @default(LOCAL)
  asrModel  AsrModel?        @map("asr_model")
  modelSize ModelSize?       @map("model_size")

  fullText  String? @map("full_text") @db.Text
  wordCount Int?    @map("word_count")

  isEdited          Boolean   @default(false) @map("is_edited")
  version           Int       @default(1)
  fullTextUpdatedAt DateTime? @map("full_text_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  media   Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  job     ProcessingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  project Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  segments        TranscriptSegment[]
  words           TranscriptWord[]
  videoChapters   VideoChapter[]
  clipCandidates  ClipCandidate[]
  shortClips      ShortClip[]
  generatedAssets GeneratedAsset[]
  editDraft       TranscriptEditDraft?

  @@index([mediaId])
  @@index([jobId])
  @@index([projectId])
  @@index([source])
  @@map("transcripts")
}

model TranscriptSegment {
  id           String @id @default(uuid()) @db.Uuid
  transcriptId String @map("transcript_id") @db.Uuid
  mediaId      String @map("media_id") @db.Uuid

  segmentIndex Int   @map("segment_index")
  startTime    Float @map("start_time")
  endTime      Float @map("end_time")

  text      String  @db.Text
  cleanText String? @map("clean_text") @db.Text

  confidence   Float?
  speakerLabel String? @map("speaker_label") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  media      Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  words TranscriptWord[]

  @@unique([transcriptId, segmentIndex])
  @@index([transcriptId])
  @@index([mediaId])
  @@index([startTime, endTime])
  @@map("transcript_segments")
}

model TranscriptWord {
  id           String @id @default(uuid()) @db.Uuid
  transcriptId String @map("transcript_id") @db.Uuid
  segmentId    String @map("segment_id") @db.Uuid
  mediaId      String @map("media_id") @db.Uuid

  wordIndex        Int @map("word_index")
  segmentWordIndex Int @map("segment_word_index")

  startTime Float @map("start_time")
  endTime   Float @map("end_time")

  text      String  @db.Text
  cleanText String? @map("clean_text") @db.Text

  confidence   Float?
  speakerLabel String? @map("speaker_label") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  transcript Transcript        @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  segment    TranscriptSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  media      Media             @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, wordIndex])
  @@unique([segmentId, segmentWordIndex])
  @@index([transcriptId])
  @@index([segmentId])
  @@index([mediaId])
  @@index([startTime, endTime])
  @@map("transcript_words")
}

model TranscriptEditDraft {
  id           String @id @default(uuid()) @db.Uuid
  transcriptId String @unique @map("transcript_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid

  baseTranscriptVersion Int @map("base_transcript_version")
  revision              Int @default(1)
  clientSequence        Int @default(0) @map("client_sequence")

  blocks Json

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  appliedAt   DateTime? @map("applied_at")
  discardedAt DateTime? @map("discarded_at")

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transcriptId])
  @@map("transcript_edit_drafts")
}

model VideoChapter {
  id           String  @id @default(uuid()) @db.Uuid
  mediaId      String  @map("media_id") @db.Uuid
  transcriptId String  @map("transcript_id") @db.Uuid
  jobId        String? @map("job_id") @db.Uuid
  projectId    String? @map("project_id") @db.Uuid

  chapterIndex Int   @map("chapter_index")
  startTime    Float @map("start_time")
  endTime      Float @map("end_time")

  title String @db.VarChar(255)

  transcriptVersion Int     @map("transcript_version")
  version           Int     @default(1)
  isEdited          Boolean @default(false) @map("is_edited")

  source ChapterSource @default(SEGMENTS)
  score  Float?

  boundaryScore        Float? @map("boundary_score")
  pauseScore           Float? @map("pause_score")
  discourseMarkerScore Float? @map("discourse_marker_score")
  semanticShiftScore   Float? @map("semantic_shift_score")
  lexicalShiftScore    Float? @map("lexical_shift_score")
  valleyDepthScore     Float? @map("valley_depth_score")
  boundaryQualityScore Float? @map("boundary_quality_score")
  durationScore        Float? @map("duration_score")
  llmConfidenceScore   Float? @map("llm_confidence_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  media      Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  transcript Transcript     @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  job        ProcessingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  clipCandidates  ClipCandidate[]
  shortClips      ShortClip[]
  generatedAssets GeneratedAsset[]

  @@unique([transcriptId, chapterIndex])
  @@index([mediaId])
  @@index([transcriptId])
  @@index([jobId])
  @@index([projectId])
  @@index([startTime, endTime])
  @@map("video_chapters")
}

model ClipCandidate {
  id           String  @id @default(uuid()) @db.Uuid
  mediaId      String  @map("media_id") @db.Uuid
  transcriptId String  @map("transcript_id") @db.Uuid
  chapterId    String? @map("chapter_id") @db.Uuid
  jobId        String? @map("job_id") @db.Uuid
  projectId    String? @map("project_id") @db.Uuid

  startTime Float @map("start_time")
  endTime   Float @map("end_time")
  duration  Float

  transcriptVersion Int @map("transcript_version")

  text      String? @db.Text
  cleanText String? @map("clean_text") @db.Text

  hookScore          Float? @map("hook_score")
  questionScore      Float? @map("question_score")
  keywordScore       Float? @map("keyword_score")
  durationScore      Float? @map("duration_score")
  speechDensityScore Float? @map("speech_density_score")
  saliencyScore      Float? @map("saliency_score")
  completenessScore  Float? @map("completeness_score")
  emotionScore       Float? @map("emotion_score")
  finalScore         Float? @map("final_score")

  llmScore  Float?  @map("llm_score")
  llmReason String? @map("llm_reason") @db.Text

  dedupGroupId String? @map("dedup_group_id") @db.VarChar(100)
  metadata     Json?

  status ClipCandidateStatus @default(CANDIDATE)

  createdAt DateTime @default(now()) @map("created_at")

  media      Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  transcript Transcript     @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  chapter    VideoChapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  job        ProcessingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  shortClips ShortClip[]

  @@index([mediaId])
  @@index([transcriptId])
  @@index([chapterId])
  @@index([jobId])
  @@index([projectId])
  @@index([status])
  @@index([finalScore])
  @@index([startTime, endTime])
  @@map("clip_candidates")
}

model ShortClip {
  id           String  @id @default(uuid()) @db.Uuid
  mediaId      String  @map("media_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  transcriptId String? @map("transcript_id") @db.Uuid
  chapterId    String? @map("chapter_id") @db.Uuid
  candidateId  String? @map("candidate_id") @db.Uuid
  projectId    String? @map("project_id") @db.Uuid

  title       String? @db.VarChar(255)
  caption     String? @db.Text
  description String? @db.Text
  hashtags    Json?

  startTime Float @map("start_time")
  endTime   Float @map("end_time")
  duration  Float

  transcriptVersion Int? @map("transcript_version")

  score  Float?
  reason String? @db.Text

  videoPath     String? @map("video_path") @db.Text
  thumbnailPath String? @map("thumbnail_path") @db.Text
  subtitlePath  String? @map("subtitle_path") @db.Text

  aspectRatio String?         @map("aspect_ratio") @db.VarChar(20)
  status      ShortClipStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  media      Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript Transcript?    @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  chapter    VideoChapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  candidate  ClipCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  publishTasks    PublishTask[]
  generatedAssets GeneratedAsset[]

  @@index([mediaId])
  @@index([userId])
  @@index([transcriptId])
  @@index([chapterId])
  @@index([candidateId])
  @@index([projectId])
  @@index([status])
  @@map("short_clips")
}

model GeneratedAsset {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  mediaId      String? @map("media_id") @db.Uuid
  projectId    String? @map("project_id") @db.Uuid
  transcriptId String? @map("transcript_id") @db.Uuid
  chapterId    String? @map("chapter_id") @db.Uuid
  shortClipId  String? @map("short_clip_id") @db.Uuid
  jobId        String? @map("job_id") @db.Uuid

  assetType         AssetType @map("asset_type")
  transcriptVersion Int?      @map("transcript_version")

  s3Bucket String  @map("s3_bucket") @db.VarChar(255)
  s3Key    String  @map("s3_key") @db.Text
  s3Region String? @map("s3_region") @db.VarChar(100)
  s3Etag   String? @map("s3_etag") @db.VarChar(255)

  mimeType      String? @map("mime_type") @db.VarChar(100)
  fileSizeBytes BigInt? @map("file_size_bytes")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  media      Media?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  transcript Transcript?    @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  chapter    VideoChapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  shortClip  ShortClip?     @relation(fields: [shortClipId], references: [id], onDelete: SetNull)
  job        ProcessingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([s3Bucket, s3Key])
  @@index([userId])
  @@index([mediaId])
  @@index([projectId])
  @@index([transcriptId])
  @@index([chapterId])
  @@index([shortClipId])
  @@index([jobId])
  @@index([assetType])
  @@index([mediaId, assetType, createdAt])
  @@map("generated_assets")
}

model AiSuggestion {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid

  targetType TargetType @map("target_type")
  targetId   String     @map("target_id") @db.Uuid

  suggestionType SuggestionType @map("suggestion_type")
  platform       Platform?

  content Json
  model   String? @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([targetType, targetId])
  @@index([suggestionType])
  @@index([platform])
  @@map("ai_suggestions")
}

model PlatformAccount {
  id                String @id @default(uuid()) @db.Uuid
  workspaceId       String @map("workspace_id") @db.Uuid
  connectedByUserId String @map("user_id") @db.Uuid

  platform Platform

  accountName    String? @map("account_name") @db.VarChar(255)
  platformUserId String? @map("platform_user_id") @db.VarChar(255)
  avatarUrl      String? @map("avatar_url") @db.Text

  accessTokenEncrypted  String?   @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?   @map("refresh_token_encrypted") @db.Text
  tokenLast4            String?   @map("token_last4") @db.VarChar(10)
  expiresAt             DateTime? @map("expires_at")

  status PlatformAccountStatus @default(CONNECTED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy User      @relation("PlatformAccountConnectedBy", fields: [connectedByUserId], references: [id], onDelete: Cascade)

  publishTasks PublishTask[]

  @@unique([workspaceId, platform])
  @@index([workspaceId])
  @@index([connectedByUserId])
  @@index([platform])
  @@map("platform_accounts")
}

model PlatformOAuthState {
  id                String @id @default(uuid()) @db.Uuid
  workspaceId       String @map("workspace_id") @db.Uuid
  initiatedByUserId String @map("user_id") @db.Uuid

  platform  Platform
  stateHash String   @unique @map("state_hash") @db.Text
  expiresAt DateTime @map("expires_at")

  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  initiatedBy User      @relation("PlatformOAuthStateInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([initiatedByUserId])
  @@index([platform])
  @@index([expiresAt])
  @@map("platform_oauth_states")
}

model PublishTask {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  mediaId           String? @map("media_id") @db.Uuid
  projectId         String? @map("project_id") @db.Uuid
  shortClipId       String? @map("short_clip_id") @db.Uuid
  platformAccountId String? @map("platform_account_id") @db.Uuid
  jobId             String? @map("job_id") @db.Uuid

  platform Platform

  title       String? @db.Text
  caption     String? @db.Text
  description String? @db.Text
  hashtags    Json?

  status PublishStatus @default(DRAFT)

  scheduledAt DateTime? @map("scheduled_at")
  publishedAt DateTime? @map("published_at")

  platformPostId  String? @map("platform_post_id") @db.Text
  platformPostUrl String? @map("platform_post_url") @db.Text
  errorMessage    String? @map("error_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  media           Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shortClip       ShortClip?       @relation(fields: [shortClipId], references: [id], onDelete: SetNull)
  platformAccount PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: SetNull)
  job             ProcessingJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([mediaId])
  @@index([projectId])
  @@index([shortClipId])
  @@index([platformAccountId])
  @@index([jobId])
  @@index([platform])
  @@index([status])
  @@map("publish_tasks")
}

model AuditLog {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid

  entityType String @map("entity_type") @db.VarChar(50)
  entityId   String @map("entity_id") @db.Uuid

  action String @db.VarChar(50)

  beforeData Json? @map("before_data")
  afterData  Json? @map("after_data")

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}
